 "records": {
  "log": {
   "every": "week",
   "role": "EVENT",
   "lines_from": "service",
   "header": {
    "en": "Weekly incident report {period}:",
    "de": "Wöchentlicher Störungsbericht {period}:",
    "es": "Informe semanal de incidencias {period}:",
    "ar": "تقرير الحوادث الأسبوعي {period}:",
    "hi": "साप्ताहिक इंसिडेंट रिपोर्ट {period}:"
   },
   "line": {
    "en": "{service} ({service.name}): {p1} P1 incidents",
    "de": "{service} ({service.name}): {p1} P1-Störungen",
    "es": "{service} ({service.name}): {p1} incidencias P1",
    "ar": "{service} ({service.name}): {p1} حوادث P1",
    "hi": "{service} ({service.name}): {p1} P1 इंसिडेंट"
   },
   "fields": {
    "p1": {
     "min": 0,
     "max": 2
    }
   },
   "boost": [
    {
     "period": {
      "year_offset": -1,
      "quarter": 3
     },
     "keys": [
      "SVC-VPN",
      "SVC-SSO",
      "SVC-ERP"
     ],
     "field": "p1",
     "factor": 4
    }
   ]
  }
 },
 "sizes": {
  "standard": {},
  "large": {
   "years": 4,
   "every": {
    "log": "day"
   }
  }

# ─────────────────────────────────────────────────────────────────────────────
#  Memory Service — the environment (deployment facts only)
# ─────────────────────────────────────────────────────────────────────────────
#
#  Copy to .env and edit. `.env` is git-ignored and never copied into the image;
#  docker-compose.yml reads it with `env_file:`, so the same file works for a host
#  run and for compose.
#
#  Only deployment facts live here: where things are, secrets, ports and worker
#  counts. Everything that makes the product what it is - models, retrieval depth,
#  budgets, timeouts, retries, rate limits, thresholds - is a constant in
#  src/memory_service/config/constants.py. What can be derived is derived: the
#  model is available when an endpoint can be resolved, tracing when
#  OTEL_EXPORTER_OTLP_ENDPOINT is, the authentication mode from the credentials
#  configured below.
#
#  Service settings are nested with `__`: MEMORY__<block>__<field>. The
#  platform's shared names (LLM_*, OTEL_*, WEB_CONCURRENCY) are unprefixed.
#  Every variable the service reads is listed here, once.
# ─────────────────────────────────────────────────────────────────────────────


# ── Service ──────────────────────────────────────────────────────────────────

# dev | test | staging | prod. staging and prod are deployed: the startup check
# refuses development keys under them, and blobs go to GCS.
MEMORY__SERVICE__ENVIRONMENT=dev
# The port the API listens on.
# MEMORY__SERVICE__PORT=8080
# DEBUG | INFO | WARNING | ERROR.
MEMORY__SERVICE__LOG_LEVEL=INFO
# JSON lines for a log collector; false for the human-readable console renderer.
MEMORY__SERVICE__LOG_JSON=true
# uvicorn worker processes (1-8); the image sets WEB_CONCURRENCY=3, which this defaults
# to. Unset everywhere: one per CPU the container may use, clamped to 1-8.
# MEMORY__SERVICE__WORKERS=3
# Background jobs one worker process runs at once (1-8). Unset: one per CPU, clamped 1-8.
# MEMORY__TASKS__WORKER_CONCURRENCY=4
# Of those, at most this many (and never more than a quarter) index: the jobs that make a write
# findable, on slots of their own.
# MEMORY__TASKS__INDEXING_CONCURRENCY=2
# Where the job worker serves Prometheus metrics and its healthcheck.
# MEMORY__TASKS__METRICS_PORT=9464


# ── Authentication (the mode follows from what is set) ───────────────────────

# The platform operator's secret: onboards tenants and issues their first admin
# key (POST /v1/admin/tenants). Setting it selects api_key mode, where every
# other caller presents a key the service issued (POST /v1/keys). Unset it once
# onboarding is done; issued keys keep working.
# MEMORY__AUTHENTICATION__BOOTSTRAP_ADMIN_KEY=<openssl rand -base64 32>
# Development keys that trust the context headers as given (laptops only; refused
# in staging and prod). Set alone, they select trusted_dev mode.
MEMORY__AUTHENTICATION__TRUSTED_DEV_API_KEYS=["dev-key"]
# The tenant a development key acts in when a request names none, and the one
# GET /v1/keys/self reports for it (the harness's local tenant is the same).
# MEMORY__AUTHENTICATION__TRUSTED_DEV_TENANT=default
# An issuer's JWKS selects jwt mode (per-customer deployments behind a gateway).
# MEMORY__AUTHENTICATION__JWT_JWKS_URL=https://issuer/.well-known/jwks.json
# MEMORY__AUTHENTICATION__JWT_ISSUER=https://issuer
# MEMORY__AUTHENTICATION__JWT_AUDIENCE=memory-service
# The claim a jwt/trusted_dev credential must carry naming the tenant it acts for
# (a shared deployment); unset trusts the tenant header.
# MEMORY__AUTHENTICATION__TENANT_CLAIM=tenant


# ── The model endpoint ───────────────────────────────────────────────────────

# Configure the harness only and memory follows: the harness registers each agent's
# endpoint (PUT /v1/agents/model-key) and the service calls that agent's model for its
# memory. These four are the service's own endpoint, the same names the harness reads,
# for tenants and agents that registered none and for running the service on its own.
# Unset LLM_BASE_URL: only registered endpoints are called (none: every path runs its
# deterministic native form).
# Any OpenAI-compatible API root: OpenAI, OpenRouter, a LiteLLM proxy, Bifrost,
# Ollama, vLLM, llama.cpp, the Anthropic or Gemini compatible endpoints.
LLM_BASE_URL=http://localhost:8091/v1
# The bearer key (LLM_AUTH=bearer); unset for a local server that takes none.
LLM_API_KEY=
# The route: openai-compatible (any endpoint) or bifrost (adds Bifrost's per-call
# headers: no content logging, no gateway MCP tools).
LLM_GATEWAY=openai-compatible
# The auth: bearer (LLM_API_KEY), google (Vertex AI: application default
# credentials; the bifrost-sdk[google] extra) or aws (Bedrock: SigV4 from the AWS
# environment; the bifrost-sdk[aws] extra).
LLM_AUTH=bearer
# The model the service's own endpoint calls for every use; unset: the tenant
# policy's, else one chosen from the endpoint's /models where its listing says enough.
# MEMORY__MODELS__LLM__MODEL=gpt-4.1-mini
# What that model accepts: a reasoning model (or one that takes no temperature) is
# sent max_completion_tokens and no temperature.
# MEMORY__MODELS__LLM__PROFILE__REASONING_OUTPUT=false
# MEMORY__MODELS__LLM__PROFILE__TEMPERATURE=true
# MEMORY__MODELS__LLM__PROFILE__MAX_OUTPUT_TOKENS=
# MEMORY__MODELS__LLM__PROFILE__TOOL_CALLING=true
# false: registered endpoints are stored but never called; every call uses the
# service's own endpoint (or none).
# MEMORY__MODELS__LLM__ACCEPT_AGENT_ENDPOINTS=true
# Envelope keys that encrypt registered model endpoints at rest: the active version and
# the keyring (base64 of 32 random bytes each; keep old versions while rotating).
# Required in staging and prod (registration is refused without them). Unset in dev
# and test, a development key derived from the configuration is used instead and a
# warning says so: it protects nothing, so set real keys before storing a real one.
# MEMORY__AGENT_CREDENTIALS__ACTIVE_KEY_ID=v1
# MEMORY__AGENT_CREDENTIALS__ENCRYPTION_KEYS={"v1":"<base64-encoded-32-byte-key>"}

# A Hindsight extraction service, when the deployment runs one (install the
# [hindsight] extra): non-agent contextual extraction goes through it.
# MEMORY__HINDSIGHT__BASE_URL=http://localhost:8888
# MEMORY__HINDSIGHT__API_KEY=<server-authentication-token>


# ── The customer's calendar ──────────────────────────────────────────────────

# A retailer's fiscal calendar: 454, 445 or 544, then optionally the month the year
# ends in and `end` (445-12, 454-01-end). Fiscal phrases ("LY", "wk 32", "FW26")
# then resolve to days in it, and planning shorthand ("WOS") is searched expanded.
# MEMORY__RETAIL_CALENDAR=454


# ── Observability ────────────────────────────────────────────────────────────

# OTLP/HTTP traces endpoint (the collector). Set: tracing is on.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces


# ── Stores (set by docker-compose.yml under compose; for a host run only) ─────

# MEMORY__DATABASE__URL=postgresql+psycopg://memory:memory@localhost:5432/memory
# Behind a transaction-mode PgBouncer (compose does this): the URL above is the pooler,
# this is PostgreSQL itself for the queue, the graph traversal and migrations.
# MEMORY__DATABASE__DIRECT_URL=postgresql+psycopg://memory:memory@localhost:5432/memory
# MEMORY__DATABASE__TRANSACTION_POOLER=false
# Connections one pod may open, all processes and pools together; each process takes
# budget // processes and splits it 4:2:1 (requests : graph : queue). Unset: 28 a process.
# MEMORY__DATABASE__CONNECTION_BUDGET=84
# MEMORY__CACHE__URL=redis://localhost:6379/0
# MEMORY__SEARCH__QDRANT_URL=http://localhost:6333
# Qdrant's gRPC port; every query goes over gRPC, the URL above stays REST.
# MEMORY__SEARCH__QDRANT_GRPC_PORT=6334
# MEMORY__SEARCH__QDRANT_API_KEY=
# A Qdrant cluster's layout for new collections (one node: 1, 1, 1). Existing collections
# take new values only through a rebuild; see docs/deploy/search.md.
# MEMORY__SEARCH__SHARD_NUMBER=1
# MEMORY__SEARCH__REPLICATION_FACTOR=1
# MEMORY__SEARCH__WRITE_CONSISTENCY_FACTOR=1
# MEMORY__AUTHORIZATION__OPENFGA_API_URL=http://localhost:8081
# Pin the store and model only to ones this build wrote (openfga.model_written log).
# MEMORY__AUTHORIZATION__OPENFGA_STORE_ID=
# MEMORY__AUTHORIZATION__OPENFGA_MODEL_ID=
# MEMORY__AUTHORIZATION__OPENFGA_API_TOKEN=


# ── Blob storage (archives, documents, large tool outputs) ───────────────────

# The store is not a setting: GCS in staging and prod (or with STORAGE_EMULATOR_HOST set),
# the filesystem under FILESYSTEM_ROOT otherwise.
# MEMORY__BLOB__FILESYSTEM_ROOT=./.blob
# MEMORY__BLOB__CHAT_BUCKET=memory-chat-archive
# MEMORY__BLOB__FILE_BUCKET=memory-file-archive
# MEMORY__BLOB__GCS_PROJECT=<gcp-project>

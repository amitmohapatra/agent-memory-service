# ─────────────────────────────────────────────────────────────────────────────
#  Memory Service — operator settings
# ─────────────────────────────────────────────────────────────────────────────
#
#  Copy to .env and edit.  `.env` is git-ignored and is never copied into the
#  image (.dockerignore excludes it); docker-compose.yml reads it with
#  `env_file:` instead, so the same file works for a host run and for compose.
#
#  WHAT BELONGS HERE            things an operator chooses: secrets, the LLM,
#                               log level, observability, authentication.
#
#  WHAT DOES NOT                anything that is a fact about the compose
#                               topology — the database URL, the cache URL, the
#                               Qdrant and OpenFGA URLs, /data and /models paths.
#                               docker-compose.yml sets those, and compose
#                               `environment:` beats `env_file:`, so a copy here
#                               would look set and silently do nothing.
#
#                               And nothing that tunes the product: the models,
#                               retrieval depth, budgets, timeouts and
#                               thresholds are constants in
#                               src/memory_service/config/constants.py.  The
#                               service that was benchmarked and the service
#                               that ships are the same artefact; an env file
#                               cannot make them differ.
#
#  Every value below is optional.  The defaults are the ones the service ships
#  with, and they are the right ones for a laptop.
#
#  Settings are nested with `__`:  MEMORY__<block>__<field>.
#  The full surface (~40 fields) is src/memory_service/config/settings.py.
# ─────────────────────────────────────────────────────────────────────────────


# ── Service ──────────────────────────────────────────────────────────────────

# dev | test | staging | prod.  `staging` and `prod` are deployed, so the startup
# check refuses the development authentication mode and the filesystem blob store
# under them.  `test` is for the suite and the benchmarks, which want those
# defaults, and `dev` is the laptop.
MEMORY__SERVICE__ENVIRONMENT=dev

# DEBUG | INFO | WARNING | ERROR.  The test suite runs at WARNING.
MEMORY__SERVICE__LOG_LEVEL=INFO

# JSON lines for a log collector; false gives the human-readable console
# renderer, which is what you want on a laptop and nowhere else.
MEMORY__SERVICE__LOG_JSON=true

# Requests per tenant per minute (0 disables), counted in the cache.
# 1200 is exactly the 20 rps the service is measured at, so a load run against
# one tenant and one key spent itself answering 429s; the budget is a guard
# against a runaway client, not the target rate.
MEMORY__SERVICE__RATE_LIMIT_PER_MINUTE=6000

# uvicorn worker processes (1-8).  The image sets WEB_CONCURRENCY, which is the
# same number under the name the rest of the ecosystem uses and is what this
# setting defaults to; set this one only to override it.
# MEMORY__SERVICE__WORKERS=3


# ── Authentication ───────────────────────────────────────────────────────────
#
# Every request carries a tenant, a user and a workspace in trusted headers
# (X-Trellis-Tenant / X-Trellis-User / X-Trellis-Workspace).  `trusted_dev` means
# the gateway in front of this service is trusted to have authenticated them;
# `jwt` verifies a bearer token against MEMORY__AUTHENTICATION__JWT_JWKS_URL.

MEMORY__AUTHENTICATION__MODE=trusted_dev
# Tenant administration (POST /v1/admin/tenants, /v1/keys, /v1/workspaces, /v1/groups) is an
# api_key-mode power; in jwt mode the issuer's token is the calling service and administers
# nothing. The OpenFGA model is rolled forward by the service itself; pin
# MEMORY__AUTHORIZATION__OPENFGA_MODEL_ID only to a model this build wrote (unpin, start one
# instance, take the id from the openfga.model_written log line, pin it).
# api_key: keys the service issues itself (POST /v1/admin/tenants, POST /v1/keys), each
# naming the tenant - and optionally the workspace - it may act for. The tenant then comes
# from the key, so a caller need not send X-Trellis-Tenant, and cannot reach another tenant by
# sending a different one. One secret bootstraps the platform; it onboards tenants and acts
# for none. Unset it once onboarding is done. This is the mode for a shared deployment.
# MEMORY__AUTHENTICATION__MODE=api_key
# MEMORY__AUTHENTICATION__BOOTSTRAP_ADMIN_KEY=<long random secret>

# API keys accepted in X-API-Key.  Replace before anything but a laptop.
MEMORY__AUTHENTICATION__TRUSTED_DEV_API_KEYS=["dev-key"]


# ── Native LLM calls: credential-gated automatic mode via Bifrost ─────────────
# Without an agent/operator key, ingestion and retrieval remain model-free.
# Set false to prohibit generation, including for agents with registered keys.
# Automatic mode discovers recognized text models through the authenticated /models API.
# No tools/MCP are permitted. Reads still require use_llm=true independently of ingestion.
MEMORY__MODELS__LLM__ENABLED=auto
MEMORY__MODELS__LLM__BASE_URL=http://localhost:8091/v1
MEMORY__MODELS__LLM__API_KEY=
MEMORY__MODELS__LLM__MODEL=auto
MEMORY__MODELS__LLM__FAST_MODEL=auto
# Which deterministic paths may consult the model.  Empty means none.
#   contextual_extraction    source-preserving units for eligible multi-topic messages
#   ambiguous_extraction     a clause the rules matched with low confidence
#   ambiguous_worthiness     is this worth remembering at all
#   relation_extraction      subject-predicate-object from prose
#   entity_resolution        are these two names the same thing
#   conflict_adjudication    two memories disagree; which wins
#   summaries                document and conversation summaries
#   reflection               periodic insight over a principal's memories
#   briefs                   background synthesis for explicitly assisted standing briefs
#   query_expansion          widen a query before retrieval
#   chunk_context            give a chunk its surrounding context
#   grounding_judge          did this answer follow from this evidence
# Automatic defaults: contextual_extraction, reflection, briefs, query_expansion.
# An explicit empty list disables every use. True mode requires an explicit nonempty list.
# MEMORY__MODELS__LLM__USES=[]
# Ingestion-only profile (after migrations): ENABLED=true, choose working MODEL/FAST_MODEL,
# USES=["contextual_extraction","reflection"]. Query-time LLM uses remain opt-in.
# Reflection runs periodically; failures preserve the native source memories.
MEMORY__MODELS__LLM__FAST_USES=["ambiguous_worthiness","contextual_extraction","query_expansion","chunk_context"]
# A reasoning model spends its output budget thinking before it emits anything,
# so too small a ceiling returns 200 OK with an empty string.
MEMORY__MODELS__LLM__MAX_TOKENS=1024
MEMORY__MODELS__LLM__TIMEOUT_SECONDS=30.0
# Retry sleeps sit outside the request timeout, so a rate-limited call with
# retries on can hold a worker slot for the sum of its backoffs.
MEMORY__MODELS__LLM__MAX_RETRIES=2

# Non-agent contextual extraction uses Hindsight's stateless preview endpoint. This SDK
# needs a separately configured Hindsight server; its authentication key is NOT a model VK.
# All agent extraction uses the owner-bound Bifrost path. Native mode needs neither server
# nor model credit. Consolidation has a separate, currently unpromoted frozen policy.
# MEMORY__HINDSIGHT__BASE_URL=http://localhost:8888
# MEMORY__HINDSIGHT__API_KEY=<server-authentication-token>
# MEMORY__HINDSIGHT__BANK_ID=extraction-preview
# MEMORY__HINDSIGHT__TIMEOUT_SECONDS=30
# MEMORY__HINDSIGHT__MAX_CONCURRENCY=1


# ── The encoder ──────────────────────────────────────────────────────────────

# torch intra-op threads for the in-process models; unset means the number frozen
# with the encoder (2), not torch's own default.  set_num_threads is process-wide,
# so this one number is shared by the encoder and the NLI head - two models that
# each fan over every core are worse than two that each take a share.  The models
# themselves are not settings.
# MEMORY__MODELS__EMBEDDING__THREADS=2


# ── Observability ────────────────────────────────────────────────────────────

# none | console | otlp.  Tracing is on exactly when something receives it.
MEMORY__OBSERVABILITY__OTEL_EXPORTER=none
MEMORY__OBSERVABILITY__OTEL_ENDPOINT=


# ── Host-only ────────────────────────────────────────────────────────────────
#
# Uncomment ONLY when running the service directly on the host (`make dev`).
# Under compose these come from docker-compose.yml and must not be set here.
#
# MEMORY__DATABASE__URL=postgresql+psycopg://memory:memory@localhost:5432/memory
# MEMORY__CACHE__URL=redis://localhost:6379/0
# MEMORY__SEARCH__QDRANT_URL=http://localhost:6333
# Qdrant's gRPC port; the URL above stays the REST endpoint (dashboard,
# snapshots), and every query this service makes goes over gRPC.
# MEMORY__SEARCH__QDRANT_GRPC_PORT=6334
# MEMORY__AUTHORIZATION__OPENFGA_API_URL=http://localhost:8081
# MEMORY__BLOB__FILESYSTEM_ROOT=./.blob

# Agent-owned Bifrost virtual keys are encrypted in PostgreSQL. Configure a keyring
# through the deployment secret manager before using PUT /v1/agents/model-key.
# Each value is a base64-encoded random 32-byte key; retain old versions during rotation.
# MEMORY__AGENT_CREDENTIALS__ACTIVE_KEY_ID=v1
# MEMORY__AGENT_CREDENTIALS__ENCRYPTION_KEYS={"v1":"<base64-encoded-32-byte-key>"}
# Retrieval requests default to use_llm=false independently of ingestion settings.

# Copy to .env for local development. Nested keys use double underscores.
MEMORY__SERVICE__ENVIRONMENT=dev
MEMORY__SERVICE__LOG_LEVEL=INFO
MEMORY__SERVICE__LOG_JSON=false

MEMORY__DATABASE__URL=postgresql+psycopg://memory:memory@localhost:5432/memory

MEMORY__CACHE__PROVIDER=dragonfly
MEMORY__CACHE__URL=redis://localhost:6379/0

MEMORY__SEARCH__PROVIDER=qdrant
MEMORY__SEARCH__QDRANT_URL=http://localhost:6333
# Or run Qdrant embedded (no server): MEMORY__SEARCH__QDRANT_LOCAL_PATH=./.qdrant

MEMORY__AUTHORIZATION__PROVIDER=openfga
MEMORY__AUTHORIZATION__OPENFGA_API_URL=http://localhost:8081
# MEMORY__AUTHORIZATION__OPENFGA_STORE_ID=
# MEMORY__AUTHORIZATION__OPENFGA_MODEL_ID=

MEMORY__AUTHENTICATION__MODE=trusted_dev
MEMORY__AUTHENTICATION__TRUSTED_DEV_API_KEYS=["dev-key"]

MEMORY__BLOB__PROVIDER=filesystem
MEMORY__BLOB__FILESYSTEM_ROOT=./.blob
# Production: MEMORY__BLOB__PROVIDER=gcs  MEMORY__BLOB__GCS_PROJECT=my-project

MEMORY__TASKS__PROVIDER=procrastinate

MEMORY__MODELS__LLM__ENABLED=false
MEMORY__MODELS__EMBEDDING__PROVIDER=sentence_transformers
MEMORY__MODELS__EMBEDDING__MODEL=ibm-granite/granite-embedding-small-english-r2
# MEMORY__MODELS__EMBEDDING__MODEL_PATH=./models/granite-embedding-small-english-r2
MEMORY__MODELS__RERANKER__MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
# MEMORY__MODELS__RERANKER__MODEL_PATH=./models/ms-marco-MiniLM-L6-v2

MEMORY__OBSERVABILITY__OTEL_EXPORTER=none

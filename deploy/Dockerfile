# syntax=docker/dockerfile:1.7
#
# Targets:
#   runtime     (default) production image: core + the extras named by the EXTRAS build arg
#   validation  runtime + dev tooling + every extra; the repository is bind-mounted at /app so
#               the release gates run against the working tree with real weights and services
FROM python:3.12-slim AS base
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    # uv's default is 60s *per file*, which is generous on an idle machine and not enough on
    # a busy one: this build failed three times on a loaded 4-core laptop, each time on a
    # different large third-party module (transformers, antlr4, markdown_it). The timeout is
    # there to catch a hung interpreter, not to bound a slow one, so raise it rather than
    # turning off the precompilation — PYTHONDONTWRITEBYTECODE=1 means nothing recompiles at
    # runtime, so a missing .pyc would be paid for on every cold start instead.
    UV_COMPILE_BYTECODE_TIMEOUT=600
RUN apt-get update && apt-get install -y --no-install-recommends libpq5 curl && rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/astral-sh/uv:0.12 /uv /uvx /bin/

WORKDIR /app
COPY pyproject.toml uv.lock README.md ./
# workspace member metadata (sources are copied later); keeps the dependency layer cacheable
COPY sdk/python/pyproject.toml sdk/python/README.md sdk/python/
COPY integrations/langgraph/pyproject.toml integrations/langgraph/README.md integrations/langgraph/
COPY integrations/mcp/pyproject.toml integrations/mcp/README.md integrations/mcp/
# The shared gateway client. Not a workspace member but a path dependency, and an editable
# install needs its sources at sync time — so the whole (tiny) tree comes in here rather than
# just the metadata. It is generated by `make vendor`; a build from a checkout that never ran
# it fails here with a clear missing-path error rather than a confusing resolution one.
COPY vendor/bifrost-sdk vendor/bifrost-sdk

# Which optional extras go into the image. This has to contain everything the *default*
# configuration asks for, or the image and the settings disagree.
#
# `docling` used to be opt-in while `documents.parser` defaulted to "docling", so a default
# build could not honour a default setting. The fallback was not a graceful degradation
# either: the builtin parser is a text parser, and a PDF routed to it was decoded as UTF-8
# and indexed — a 39 KB PDF produced 38,494 characters starting "%PDF-1.7 %âãÏÓ 1 0 obj".
# Binary noise, embedded and stored as knowledge, with one log line as the only sign.
#
# It costs roughly 300 MB (opencv, rapidocr, pandas). A default that silently corrupts the
# index is not worth 300 MB of savings.
#
#   docker compose build --build-arg EXTRAS="gcp models"   # text-only deployments
ARG EXTRAS="gcp models docling"

FROM base AS runtime-deps
ARG EXTRAS
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-install-workspace $(for e in $EXTRAS; do echo --extra $e; done)

# docling pulls `opencv-python`, which links against X11 (libxcb, libGL) that a slim image
# does not have. The failure is not at build time: `import cv2` succeeds for nothing, and the
# first PDF dies inside TableFormer with
#   ImportError: libxcb.so.1: cannot open shared object file
# reported to the caller as "docling failed to parse <file>". `opencv-python-headless` is the
# same library built without the GUI bindings — the same `cv2` module, no X11, and cheaper
# than installing an X stack into a server image to satisfy a window-drawing dependency that
# is never used.
FROM runtime-deps AS runtime-cv
ARG EXTRAS
RUN --mount=type=cache,target=/root/.cache/uv \
    if echo "$EXTRAS" | grep -qw docling; then \
      export VIRTUAL_ENV=/opt/venv; \
      ver="$(/opt/venv/bin/python -c 'import importlib.metadata as m; print(m.version("opencv-python"))')"; \
      uv pip uninstall opencv-python; \
      uv pip install --no-cache "opencv-python-headless==$ver"; \
      /opt/venv/bin/python -c 'import cv2; print("cv2", cv2.__version__, "headless OK")'; \
    fi

FROM runtime-cv AS runtime
ARG EXTRAS
COPY src ./src
COPY sdk ./sdk
COPY integrations ./integrations
COPY migrations ./migrations
COPY alembic.ini ./
# The OpenFGA authorization model. A deployment writes it to OpenFGA the first time it finds
# no model there, so leaving it out of the image works right up until the first fresh
# install — which then fails on a missing file, reported as "OpenFGA unavailable".
COPY deploy/openfga ./deploy/openfga
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev $(for e in $EXTRAS; do echo --extra $e; done)
# COPY preserves the builder's permissions: a source tree checked out with a restrictive
# umask (0700 directories) produces an image whose own package is unreadable to the
# unprivileged runtime user, and the container exits with ModuleNotFoundError. The image
# must not depend on how the build host happened to be set up. Only the copied sources need
# this — the virtualenv is created inside the image with normal permissions.
RUN chmod -R a+rX /app/src /app/sdk /app/integrations /app/migrations /app/alembic.ini /app/deploy
ENV PATH="/opt/venv/bin:$PATH"

# The blob root, owned by the user that will run. A named volume mounted at an empty path
# takes its ownership from the image, and this path did not exist in the image — so Docker
# created it root-owned, the process runs as nobody, and every archive write failed with
# PermissionError. Measured on a running stack: archive.stage_message failed 112 times and
# retried until each job went dead, with nothing wrong in the code at all.
RUN mkdir -p /data/blob && chown -R nobody:nogroup /data

EXPOSE 8080
USER nobody
CMD ["memory-api"]

FROM base AS validation
RUN apt-get update && apt-get install -y --no-install-recommends make git procps && rm -rf /var/lib/apt/lists/*
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --all-extras --dev --no-install-workspace
ENV PATH="/opt/venv/bin:$PATH" HF_HOME=/models/hf-cache MEMORY_MODELS_DIR=/models
# the repository is mounted at /app at run time; workspace members are installed then
CMD ["sleep", "infinity"]

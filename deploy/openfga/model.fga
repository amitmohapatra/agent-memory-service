model
  schema 1.1

type user

type agent
  relations
    define operator: [user]

type tenant
  relations
    define admin: [user]
    define member: [user] or admin

type workspace
  relations
    define tenant: [tenant]
    define admin: [user] or admin from tenant
    define member: [user, agent] or admin
    define viewer: [user, agent] or member

type thread
  relations
    define tenant: [tenant]
    define workspace: [workspace]
    define owner: [user]
    define participant: [user, agent]
    define viewer: [user] or owner or participant or admin from workspace
    define can_read: viewer or admin from tenant
    define can_write: owner or participant or admin from workspace

type document
  relations
    define tenant: [tenant]
    define workspace: [workspace]
    define thread: [thread]
    define owner: [user]
    define viewer: [user, agent]
    define can_read: owner or viewer or can_read from thread or viewer from workspace or admin from tenant
    define can_write: owner or admin from workspace

type memory
  relations
    define tenant: [tenant]
    define owner: [user, agent]
    define viewer: [user, agent]
    define can_read: owner or viewer or admin from tenant
    define can_delete: owner or admin from tenant

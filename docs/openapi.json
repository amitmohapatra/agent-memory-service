                "schema": {
                  "$ref": "#/components/schemas/LiveResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness probe",
        "tags": [
          "operations"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "description": "Verifies mandatory backing stores. Optional providers never fail readiness when disabled.",
        "operationId": "ready_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "DEPENDENCY_UNAVAILABLE",
                    "details": {},
                    "message": "PostgreSQL unavailable",
                    "retryable": true,
                    "trace_id": "req_01J8ZZZZZZZZZZZZZZZZZZZZZZ"
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "PostgreSQL unavailable"
          }
        },
        "summary": "Readiness probe",
        "tags": [
          "operations"
        ]
      }
    },
    "/metrics": {

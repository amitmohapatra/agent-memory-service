{
  "name": "public_pdfs_critical",
  "description": "Critical evidence-preservation questions over four real-world public-domain PDFs parsed by Docling (CDC MMWR two-column article with tables and footnotes; Federal Reserve Financial Stability Report with a footnoted table and figures; NIST SP 800-63-3 with a table of contents, an errata table and a normative/informative table; Federal Reserve Beige Book two-column prose). Pages are 1-based within the trimmed fixture. A group is satisfied by any retrieved chunk matching one of its alternatives (document + page + substring).",
  "documents": {
    "cdc": "cdc_mmwr_7301.pdf",
    "fsr": "fed_fsr_2024_04.pdf",
    "nist": "nist_sp800_63_3.pdf",
    "beige": "fed_beige_book_2024_01.pdf"
  },
  "questions": [
    {
      "id": "cdc_volume_and_cost",
      "query": "How many topical antifungal prescriptions were filled by Medicare Part D beneficiaries in 2021 and what did they cost in total?",
      "critical": true,
      "required_groups": {
        "volume": [
          {"document": "cdc", "page": 1, "contains": "6.5 million"},
          {"document": "cdc", "page": 3, "contains": "6.5 million"},
          {"document": "cdc", "page": 5, "contains": "6.5 million"}
        ],
        "cost": [
          {"document": "cdc", "page": 1, "contains": "$231 million"},
          {"document": "cdc", "page": 3, "contains": "$231 million"},
          {"document": "cdc", "page": 5, "contains": "$231 million"}
        ]
      }
    },
    {
      "id": "cdc_table_highest_avg_cost",
      "query": "Which drug had the highest average cost per topical antifungal prescription?",
      "critical": true,
      "required_groups": {
        "efinaconazole_row": [
          {"document": "cdc", "page": 3, "contains": "1,035.38"}
        ]
      }
    },
    {
      "id": "cdc_table_region_rate",
      "query": "What was the topical antifungal prescription rate per 1,000 beneficiaries in the Northeast?",
      "critical": true,
      "required_groups": {
        "northeast": [
          {"document": "cdc", "page": 3, "contains": "188.0"}
        ]
      }
    },
    {
      "id": "cdc_top_prescribers",
      "query": "How many prescribers were in the top 10% of topical antifungal prescribers and what share of prescriptions did they write?",
      "critical": true,
      "required_groups": {
        "count": [
          {"document": "cdc", "page": 3, "contains": "13,106"},
          {"document": "cdc", "page": 4, "contains": "13,106"}
        ],
        "share": [
          {"document": "cdc", "page": 1, "contains": "44.2%"},
          {"document": "cdc", "page": 3, "contains": "44.2%"},
          {"document": "cdc", "page": 4, "contains": "44.2"}
        ]
      }
    },
    {
      "id": "cdc_primary_care_share",
      "query": "What percentage of topical antifungal prescriptions were written by primary care physicians?",
      "critical": true,
      "required_groups": {
        "share": [
          {"document": "cdc", "page": 1, "contains": "40.0%"},
          {"document": "cdc", "page": 3, "contains": "40.0%"},
          {"document": "cdc", "page": 4, "contains": "40.0"}
        ]
      }
    },
    {
      "id": "cdc_footnote_drug_list",
      "query": "Which drugs were included in the topical antifungal analysis?",
      "critical": true,
      "required_groups": {
        "footnote": [
          {"document": "cdc", "page": 2, "contains": "butoconazole"}
        ]
      }
    },
    {
      "id": "cdc_schedule_deletions",
      "query": "Which vaccines were deleted from the 2024 child and adolescent immunization schedule?",
      "critical": true,
      "required_groups": {
        "deleted": [
          {"document": "cdc", "page": 7, "contains": "were deleted from all sections"},
          {"document": "cdc", "page": 7, "contains": "no longer distributed"}
        ]
      }
    },
    {
      "id": "fsr_table_equities",
      "query": "What is the outstanding size of the equities market in the Financial Stability Report?",
      "critical": true,
      "required_groups": {
